# Server
HOST=127.0.0.1
PORT=8787
POSTGRES_ADMIN_PASSWORD=change-this-admin-password
APP_DB_USER=roos_app
APP_DB_PASSWORD=change-this-app-password
DATABASE_URL=postgres://roos_app:change-this-app-password@127.0.0.1:5432/roos
SESSION_TTL_SECONDS=604800
ADMIN_NAME=Roos Admin
ADMIN_EMAIL=admin@example.com.au
ADMIN_PASSWORD=ChangeThisAdminPassword123

# LM Studio on the host, reached from Docker Compose.
# Use http://127.0.0.1:1234/v1 when running the API directly on the host.
OPENAI_API_KEY=not-needed
OPENAI_BASE_URL=http://host.docker.internal:1234/v1
LLM_MODEL=google/gemma-4-e4b
LLM_API_STYLE=chat

# IP filtering (optional). Comma-separated IPv4/IPv6 addresses or CIDR ranges.
# Blank disables a list. A denied client gets 403. A non-empty allowlist admits only
# listed clients. The denylist always wins over the allowlist.
# Example: IP_ALLOWLIST=10.0.0.0/8,2001:db8::/32  IP_DENYLIST=203.0.113.7
IP_ALLOWLIST=
IP_DENYLIST=
# Proxies whose X-Forwarded-For header is trusted. Only the socket peer is checked.
# Behind Docker Nginx, the socket peer is the Nginx container, so set this to the
# Compose network it sits on. Find it with:
#   docker network inspect roos_default --format '{{(index .IPAM.Config 0).Subnet}}'
# Use that subnet, or the single Nginx container IP, e.g. TRUSTED_PROXIES=172.20.0.0/16
# Leave blank for direct runs with no proxy. Do not trust ranges containing clients.
TRUSTED_PROXIES=

# Optional separate OpenAI-compatible embedding provider.
# Leave these blank to reuse OPENAI_API_KEY and OPENAI_BASE_URL.
EMBEDDING_API_KEY=not-needed
EMBEDDING_BASE_URL=http://host.docker.internal:1234/v1
EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5-embedding
EMBEDDING_DIMENSIONS=768
